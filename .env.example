# Operator-only. Copy to .env, chmod 600 .env. Never put these in NEXT_PUBLIC_*.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
TIDE_LICENSE_EMAIL=
# Set yes only after personally accepting https://tide.org/legal
TIDE_TERMS_ACCEPTED=
DOCKER_HOST=unix:///var/run/docker.sock
# Optional space-separated DNS resolver IPs, tested on your current network.
# Used only when creating a NEW container; existing containers are preserved.
TIDECLOAK_DNS=
BRAND_SKIP=1
# Production may inject CLIENT_ADAPTER as JSON instead of data/tidecloak.json.
# Export the genuine Tide OIDC public-client adapter with embedded public jwk.
