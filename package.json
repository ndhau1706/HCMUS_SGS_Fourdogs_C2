{
  "name": "cloudguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node scripts/dev.mjs --production",
    "init": "bash scripts/init-tidecloak.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:integration && npm run test:browser",
    "stop": "node scripts/stop.mjs",
    "export:adapter": "node --env-file=.env scripts/export-adapter.mjs",
    "check:realm": "node --env-file=.env scripts/check-realm.mjs",
    "test:integration": "vitest run --config vitest.http.config.mts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tidecloak/nextjs": "0.14.40",
    "@tidecloak/verify": "0.14.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
